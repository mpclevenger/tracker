# Copy to .env for local development (python-dotenv is not used; export these or let the platform inject them).
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://tracker:tracker@localhost:5432/tracker

# open = every request is Tech Risk; no sign-in (build/test environment)
# dev  = pick any employee ID from the user switcher
# sso  = identity and roles from the entitlement add-on (see core/auth/sso.py)
AUTH_MODE=open
OPEN_MODE_EMP_ID=tech-risk
OPEN_MODE_DISPLAY_NAME=Tech Risk
DEV_DEFAULT_EMP_ID=
# sso mode only:
SSO_EMP_ID_HEADER=
SSO_GROUPS_HEADER=
SSO_GROUP_ROLE_MAP=
